{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug: Edge Service",
            "type": "debugpy",
            "request": "launch",
            "module": "uv",
            "args": [
                "run",
                "python",
                "-m",
                "services.edge.main"
            ],
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal"
        },
        {
            "name": "Debug: Transaction Service",
            "type": "debugpy",
            "request": "launch",
            "module": "uv",
            "args": [
                "run",
                "python",
                "-m",
                "services.transaction.main"
            ],
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal"
        },
        {
            "name": "Debug: Ledger Service",
            "type": "debugpy",
            "request": "launch",
            "module": "uv",
            "args": [
                "run",
                "python",
                "-m",
                "services.ledger.main"
            ],
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal"
        }
    ],
    "compounds": [
        {
            "name": "Debug All Services",
            "configurations": [
                "Debug: Edge Service",
                "Debug: Transaction Service",
                "Debug: Ledger Service"
            ]
        }
    ]
}